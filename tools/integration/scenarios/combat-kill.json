{
  "name": "combat-kill",
  "description": "First ENTER dismisses title (title->BUILD). Build LASER at start PAD (2,9) with M. Second ENTER releases wave; LASER auto-fires and kills DRONEs. Offsets: gold _G+5, towers_count _G+8, enemies_count _G+138, kills _G+238.",
  "steps": [
    { "op": "frames", "n": 25 },
    { "op": "assert_eq", "mem": "_G+239", "val": 0, "ctx": "state TITLE at boot" },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "phase BUILD at boot" },
    { "op": "assert_eq", "mem": "_G+5",   "val": 100, "ctx": "gold 100" },
    { "op": "assert_eq", "mem": "_G+7",   "val": 0,   "ctx": "sel LASER" },
    { "op": "assert_eq", "mem": "_G+8",   "val": 0,   "ctx": "towers 0" },
    { "op": "assert_eq", "mem": "_G+238", "val": 0,   "ctx": "kills 0 pre-combat" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+239", "val": 1, "ctx": "state PLAY after title dismiss" },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "phase BUILD after title dismiss" },
    { "op": "assert_eq", "mem": "_G+3",   "val": 2, "ctx": "cursor_col 2" },
    { "op": "assert_eq", "mem": "_G+4",   "val": 9, "ctx": "cursor_row 9" },

    { "op": "key", "key": "M", "duration_ms": 200 },
    { "op": "frames", "n": 15 },
    { "op": "assert_eq", "mem": "_G+8", "val": 1, "ctx": "LASER built" },
    { "op": "assert_eq", "mem": "_G+5", "val": 80, "ctx": "gold 100-20" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+2", "val": 1, "ctx": "phase WAVE" },
    { "op": "assert_nonzero", "mem": "_G+138", "ctx": "enemies spawning" },

    { "op": "frames", "n": 150 },
    { "op": "assert_nonzero", "mem": "_G+238", "ctx": "kills>0: LASER killed a DRONE" }
  ]
}
