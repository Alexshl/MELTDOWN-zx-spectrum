{
  "name": "flow-win",
  "description": "First ENTER dismisses title (->BUILD). Second ENTER starts wave 0 (1 DRONE, no turret, leaks: stability 20->19). During BUILD after wave 0, press M to build LASER at (2,9). Then ENTERs release waves 1-5; LASER kills all enemies or they are few enough to not drain stability to 0. Final assert: state WIN, wave_index 5, stability > 0. Offsets: state _G+239, wave_index _G+240, stability _G+137, phase _G+2, towers_count _G+8.",
  "steps": [
    { "op": "frames", "n": 25 },
    { "op": "assert_eq", "mem": "_G+239", "val": 0, "ctx": "state TITLE at boot" },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "phase BUILD at boot" },
    { "op": "assert_eq", "mem": "_G+137", "val": 20, "ctx": "stability 20" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+239", "val": 1, "ctx": "state PLAY after title dismiss" },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "phase BUILD after title dismiss" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+2", "val": 1, "ctx": "phase WAVE (wave 0 started)" },

    { "op": "frames", "n": 500 },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0,  "ctx": "wave 0 cleared, phase BUILD" },
    { "op": "assert_eq", "mem": "_G+240", "val": 1,  "ctx": "wave_index 1" },
    { "op": "assert_eq", "mem": "_G+137", "val": 19, "ctx": "stability 19 after 1 leak" },

    { "op": "key", "key": "M", "duration_ms": 200 },
    { "op": "frames", "n": 10 },
    { "op": "assert_eq", "mem": "_G+8", "val": 1, "ctx": "LASER built at (2,9)" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+2", "val": 1, "ctx": "phase WAVE for wave 1 (4 DRONEs)" },

    { "op": "frames", "n": 700 },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "wave 1 cleared, phase BUILD" },
    { "op": "assert_eq", "mem": "_G+240", "val": 2, "ctx": "wave_index 2" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+2", "val": 1, "ctx": "phase WAVE for wave 2 (4 DRONEs)" },

    { "op": "frames", "n": 700 },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "wave 2 cleared, phase BUILD" },
    { "op": "assert_eq", "mem": "_G+240", "val": 3, "ctx": "wave_index 3" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+2", "val": 1, "ctx": "phase WAVE for wave 3 (4 RUNNERs)" },

    { "op": "frames", "n": 450 },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "wave 3 cleared, phase BUILD" },
    { "op": "assert_eq", "mem": "_G+240", "val": 4, "ctx": "wave_index 4" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+2", "val": 1, "ctx": "phase WAVE for wave 4 (4 RUNNERs)" },

    { "op": "frames", "n": 450 },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "wave 4 cleared, phase BUILD" },
    { "op": "assert_eq", "mem": "_G+240", "val": 5, "ctx": "wave_index 5" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+2", "val": 1, "ctx": "phase WAVE for wave 5 (4 BRUTEs)" },

    { "op": "frames", "n": 1000 },
    { "op": "assert_eq",      "mem": "_G+239", "val": 2,  "ctx": "state WIN after all waves cleared" },
    { "op": "assert_eq",      "mem": "_G+240", "val": 5,  "ctx": "wave_index at last wave (5)" },
    { "op": "assert_nonzero", "mem": "_G+137", "ctx": "stability > 0" }
  ]
}
