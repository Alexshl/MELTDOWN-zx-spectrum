{
  "name": "sfx-transient",
  "description": "SFX one-shot countdown: sfx_timer (_G+243) is 0 at boot, armed when SFX_WAVE_START fires, then auto-silences after SFX_FRAMES. No turret built so no SFX_FIRE re-arms the timer. 60 host frames (~25 emulated) is well under the DRONE traversal time (14 steps * 8 frames/step = 112 emulated frames). Offsets: state _G+239, phase _G+2, last_sfx _G+241, music_cursor _G+242, sfx_timer _G+243.",
  "steps": [
    { "op": "frames", "n": 25 },
    { "op": "assert_eq", "mem": "_G+239", "val": 0, "ctx": "state TITLE at boot" },
    { "op": "assert_eq", "mem": "_G+243", "val": 0, "ctx": "sfx_timer 0 at boot" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+239", "val": 1, "ctx": "state PLAY after title dismiss" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_nonzero", "mem": "_G+243", "ctx": "sfx_timer armed by SFX_WAVE_START" },
    { "op": "assert_eq", "mem": "_G+2",   "val": 1, "ctx": "phase WAVE" },
    { "op": "assert_eq", "mem": "_G+241", "val": 3, "ctx": "SFX_WAVE_START sticky" },

    { "op": "frames", "n": 60 },
    { "op": "assert_eq",      "mem": "_G+243", "val": 0, "ctx": "sfx_timer expired after one-shot window" },
    { "op": "assert_nonzero", "mem": "_G+242", "ctx": "music_cursor still advancing (music continues)" }
  ]
}
