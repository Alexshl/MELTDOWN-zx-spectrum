{
  "name": "music-playing",
  "description": "Music sequencer coexists with SFX. music_cursor (_G+242) stays 0 on TITLE (music off), advances during PLAY, and keeps advancing through SFX events. Offsets: state _G+239, last_sfx _G+241, music_cursor _G+242, phase _G+2, towers_count _G+8, kills _G+238.",
  "steps": [
    { "op": "frames", "n": 25 },
    { "op": "assert_eq", "mem": "_G+239", "val": 0, "ctx": "state TITLE at boot" },
    { "op": "assert_eq", "mem": "_G+242", "val": 0, "ctx": "music_cursor 0 at boot (music off on TITLE)" },
    { "op": "assert_eq", "mem": "_G+241", "val": 0, "ctx": "last_sfx NONE at boot" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+239", "val": 1, "ctx": "state PLAY after title dismiss" },

    { "op": "frames", "n": 200 },
    { "op": "assert_nonzero", "mem": "_G+242", "ctx": "music_cursor advanced during PLAY" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+2",   "val": 1, "ctx": "phase WAVE for wave 0" },
    { "op": "assert_eq", "mem": "_G+241", "val": 3, "ctx": "SFX_WAVE_START fires while music plays" },
    { "op": "assert_nonzero", "mem": "_G+242", "ctx": "music_cursor still advancing after SFX_WAVE_START" },

    { "op": "key", "key": "M", "duration_ms": 200 },
    { "op": "frames", "n": 15 },
    { "op": "assert_eq", "mem": "_G+8", "val": 1, "ctx": "LASER built at (2,9)" },

    { "op": "frames", "n": 150 },
    { "op": "assert_nonzero", "mem": "_G+238", "ctx": "kills > 0: LASER killed DRONE" },
    { "op": "assert_nonzero", "mem": "_G+241", "ctx": "fire/hit SFX fired during combat" },
    { "op": "assert_nonzero", "mem": "_G+242", "ctx": "music_cursor keeps advancing through combat (SFX+music coexist)" }
  ]
}
