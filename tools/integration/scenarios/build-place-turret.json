{
  "name": "build-place-turret",
  "description": "Dismiss title with ENTER (title->BUILD), then cursor move (P), default LASER, build with M, verify gold/towers_count, reject second build on occupied cell.",
  "steps": [
    { "op": "frames", "n": 25 },
    { "op": "assert_eq", "mem": "_G+239", "val": 0, "ctx": "state TITLE at boot" },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "phase BUILD at boot" },
    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+239", "val": 1, "ctx": "state PLAY after title dismiss" },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "phase still BUILD after title dismiss" },
    { "op": "assert_eq", "mem": "_G+5", "val": 100, "ctx": "starting gold 100" },
    { "op": "assert_eq", "mem": "_G+7", "val": 0, "ctx": "sel LASER" },
    { "op": "assert_eq", "mem": "_G+8", "val": 0, "ctx": "towers 0" },
    { "op": "assert_eq", "mem": "_G+3", "val": 2, "ctx": "cursor_col 2" },
    { "op": "assert_eq", "mem": "_G+4", "val": 9, "ctx": "cursor_row 9" },
    { "op": "key", "key": "P", "duration_ms": 200 },
    { "op": "frames", "n": 15 },
    { "op": "assert_eq", "mem": "_G+3", "val": 3, "ctx": "cursor moved right" },
    { "op": "assert_eq", "mem": "_G+4", "val": 9 },
    { "op": "key", "key": "M", "duration_ms": 200 },
    { "op": "frames", "n": 15 },
    { "op": "assert_eq", "mem": "_G+8", "val": 1, "ctx": "towers_count 1" },
    { "op": "assert_eq", "mem": "_G+5", "val": 80, "ctx": "gold 100-20" },
    { "op": "key", "key": "M", "duration_ms": 200 },
    { "op": "frames", "n": 15 },
    { "op": "assert_eq", "mem": "_G+8", "val": 1, "ctx": "still 1 (rejected)" },
    { "op": "assert_eq", "mem": "_G+5", "val": 80, "ctx": "gold unchanged" }
  ]
}
