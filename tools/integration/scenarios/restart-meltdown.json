{
  "name": "restart-meltdown",
  "description": "Drive to MELTDOWN (same as flow-meltdown), then press ENTER to restart and verify game resets to TITLE with gold=100, stability=20, wave_index=0, towers_count=0.",
  "steps": [
    { "op": "frames", "n": 25 },
    { "op": "assert_eq", "mem": "_G+239", "val": 0, "ctx": "state TITLE at boot" },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "phase BUILD at boot" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+239", "val": 1, "ctx": "state PLAY after title dismiss" },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "phase BUILD after title dismiss" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+2", "val": 1, "ctx": "phase WAVE for wave 0" },

    { "op": "frames", "n": 500 },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "wave 0 cleared, phase BUILD" },
    { "op": "assert_eq", "mem": "_G+240", "val": 1, "ctx": "wave_index advanced to 1" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+2", "val": 1, "ctx": "phase WAVE for wave 1" },

    { "op": "frames", "n": 700 },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "wave 1 cleared, phase BUILD" },
    { "op": "assert_eq", "mem": "_G+240", "val": 2, "ctx": "wave_index 2" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+2", "val": 1, "ctx": "phase WAVE for wave 2" },

    { "op": "frames", "n": 700 },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "wave 2 cleared, phase BUILD" },
    { "op": "assert_eq", "mem": "_G+240", "val": 3, "ctx": "wave_index 3" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+2", "val": 1, "ctx": "phase WAVE for wave 3 (RUNNER)" },

    { "op": "frames", "n": 450 },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "wave 3 cleared, phase BUILD" },
    { "op": "assert_eq", "mem": "_G+240", "val": 4, "ctx": "wave_index 4" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+2", "val": 1, "ctx": "phase WAVE for wave 4 (RUNNER)" },

    { "op": "frames", "n": 450 },
    { "op": "assert_eq", "mem": "_G+2",   "val": 0, "ctx": "wave 4 cleared, phase BUILD" },
    { "op": "assert_eq", "mem": "_G+240", "val": 5, "ctx": "wave_index 5" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 5 },
    { "op": "assert_eq", "mem": "_G+2", "val": 1, "ctx": "phase WAVE for wave 5 (BRUTE)" },

    { "op": "frames", "n": 1000 },
    { "op": "assert_eq", "mem": "_G+239", "val": 3, "ctx": "state MELTDOWN" },
    { "op": "assert_eq", "mem": "_G+137", "val": 0, "ctx": "stability 0" },

    { "op": "key", "key": "ENTER", "duration_ms": 200 },
    { "op": "frames", "n": 10 },
    { "op": "assert_eq", "mem": "_G+239", "val": 0,   "ctx": "back to TITLE after restart" },
    { "op": "assert_eq", "mem": "_G+5",   "val": 100, "ctx": "gold low byte = 100" },
    { "op": "assert_eq", "mem": "_G+6",   "val": 0,   "ctx": "gold high byte = 0" },
    { "op": "assert_eq", "mem": "_G+137", "val": 20,  "ctx": "stability reset to 20" },
    { "op": "assert_eq", "mem": "_G+240", "val": 0,   "ctx": "wave_index reset to 0" },
    { "op": "assert_eq", "mem": "_G+8",   "val": 0,   "ctx": "towers_count reset to 0" }
  ]
}
